DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# M5a API. Use a Neon BRANCH url (never main) for NEON_TEST_DATABASE_URL; the test harness uses the direct (non-pooled) host.
NEON_TEST_DATABASE_URL=postgresql://OWNER:PASSWORD@BRANCH-HOST/DBNAME?sslmode=require
API_LOGIN_PASSWORD=
API_DATABASE_URL=postgresql://api_login:PASSWORD@DIRECT-HOST/DBNAME?sslmode=require
JWT_SECRET=
# M5b triage agent. AGENT_DATABASE_URL: the api_agent_writer login (direct host, sslmode=require).
AGENT_WRITER_PASSWORD=
AGENT_DATABASE_URL=postgresql://api_agent_writer:PASSWORD@DIRECT-HOST/DBNAME?sslmode=require
# LLM providers (optional; without them the agent uses the rule-based triage). Only synthetic data may be sent.
# LLM_DATA_CLASS must be exactly "synthetic" or no provider is used.
LLM_DATA_CLASS=
LLM_PROVIDER_ORDER=nvidia,google,openrouter
LLM_MODEL_NVIDIA=
LLM_MODEL_GOOGLE=
LLM_MODEL_OPENROUTER=
NVIDIA_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
